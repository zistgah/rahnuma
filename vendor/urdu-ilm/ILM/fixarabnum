#!/bin/sh
# fixarabnum — Arabic-Indic and Eastern Arabic-Indic digits to ASCII.
# Project ILM.  Copyright (C) 1993-2026 Abhishek Choudhary.  GNU GPL v2+.
#
# fixuninum converts Devanagari digits (U+0966-096F) only. It does NOT cover
# U+0660-0669 (Arabic-Indic) or U+06F0-06F9 (Eastern Arabic-Indic, used by
# Urdu, Persian, Pashto, Dari, Sindhi), so [۸۰] reached cc as an undeclared
# identifier.  Reported on the live system, 2026.
#
# NOT sed: its y command counts BYTES and these digits are multibyte, so
#   y/۰۱۲۳۴۵۶۷۸۹/0123456789/  is rejected as "different lengths".
# NOT mawk either: split(s,a,"") is byte-wise there.
# Digits inside a string literal are left alone — a string is data.
if command -v python3 >/dev/null 2>&1; then
  exec python3 -c '
import sys
M={}
for i,(a,e) in enumerate(zip("٠١٢٣٤٥٦٧٨٩","۰۱۲۳۴۵۶۷۸۹")): M[a]=M[e]=str(i)
for line in sys.stdin:
    out=[];instr=False;prev=""
    for c in line:
        if c=="\"" and prev!="\\\\": instr=not instr
        out.append(M[c] if (not instr and c in M) else c); prev=c
    sys.stdout.write("".join(out))'
elif command -v gawk >/dev/null 2>&1; then
  exec gawk 'BEGIN{split("٠ ١ ٢ ٣ ٤ ٥ ٦ ٧ ٨ ٩",a," ");split("۰ ۱ ۲ ۳ ۴ ۵ ۶ ۷ ۸ ۹",e," ")
    for(i=1;i<=10;i++){m[a[i]]=i-1;m[e[i]]=i-1}}
  {o="";s=0;n=split($0,c,"")
   for(i=1;i<=n;i++){if(c[i]=="\"" && (i==1||c[i-1]!="\\"))s=!s
     o=o ((!s&&(c[i] in m))?m[c[i]]:c[i])} print o}'
elif command -v perl >/dev/null 2>&1; then
  exec perl -CSD -pe 'tr/٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹/01234567890123456789/'
else
  echo "fixarabnum: needs python3, gawk or perl. Digits NOT converted." >&2; cat
fi
